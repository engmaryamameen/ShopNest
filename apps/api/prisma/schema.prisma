generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuditAction {
  ADMIN_PRODUCT_CREATE
  ADMIN_PRODUCT_UPDATE
  ADMIN_PRODUCT_ARCHIVE
  ADMIN_CATEGORY_CREATE
  ADMIN_CATEGORY_UPDATE
  ADMIN_CATEGORY_DELETE
  ADMIN_ORDER_STATUS_UPDATE
  ADMIN_CATALOG_IMPORT_TRIGGER
  ADMIN_USER_SUSPEND
  ADMIN_USER_REACTIVATE
  ADMIN_VENDOR_APPROVE
  ADMIN_VENDOR_REJECT
  ADMIN_VENDOR_SUSPEND
  ADMIN_ADMIN_CREATE
  ADMIN_REVIEW_HIDE
  ADMIN_REVIEW_PUBLISH
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductPublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum VendorMemberRole {
  OWNER
  STAFF
}

enum OfferCondition {
  NEW
  USED
  REFURBISHED
}

enum OfferStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum InventoryAdjustmentReason {
  RESTOCK
  SALE
  RETURN
  CORRECTION
  IMPORT_INITIAL
}

enum AttributeInputType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
}

enum CatalogSource {
  DUMMY_JSON
}

enum CatalogImportStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tokenFamilies           RefreshTokenFamily[]
  cart                    Cart?
  orders                  Order[]
  statusChanges           OrderStatusHistory[]     @relation("changedBy")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogEntries         AuditLog[]               @relation("auditActor")
  vendorMemberships       VendorMember[]
  sentVendorStaffInvites  VendorStaffInvite[]
  reviews                 Review[]
  wishlist                Wishlist[]
  addresses               Address[]
  returnRequests          ReturnRequest[]          @relation("returnRequester")
  decidedReturnRequests   ReturnRequest[]          @relation("returnDecider")
  createdPromotions       Promotion[]
  promotionRedemptions    PromotionRedemption[]

  @@index([status])
}

model RefreshTokenFamily {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked  Boolean  @default(false)
  // Customer-facing "active sessions" metadata — captured at login, updated on
  // each successful refresh. Purely descriptive; revocation logic is
  // unaffected by these fields.
  userAgent  String?
  ipAddress  String?
  label      String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tokens RefreshToken[]

  @@index([userId])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  requestIp  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @db.Uuid
  actor       User?       @relation("auditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      AuditAction
  targetType  String
  targetId    String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime    @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

model RefreshToken {
  id        String             @id @default(uuid()) @db.Uuid
  familyId  String             @db.Uuid
  family    RefreshTokenFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  tokenHash String             @unique
  isUsed    Boolean            @default(false)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime           @default(now())

  @@index([familyId])
}

/// A product belongs to exactly one canonical leaf category (no
/// multi-category bridge table — deliberately: nothing in this catalog's
/// scope needs a product to live in two places at once, and a bridge table
/// would just move the "which one is primary for breadcrumbs/canonical URL"
/// question rather than answer it). Browsing a *parent* category shows every
/// product in that category or any of its descendants — computed by walking
/// `parentId` down from the requested category (CatalogService) and
/// filtering `WHERE categoryId IN (thoseIds)`, not by a product having
/// multiple category rows.
model Category {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String                @unique
  slug                 String                @unique
  // Self-relation for the hierarchy. Cycle prevention (a category can't
  // become its own ancestor) is enforced in CategoriesService before an
  // update — Postgres has no declarative way to forbid graph cycles, only
  // application logic can walk the chain and check.
  parentId             String?               @db.Uuid
  parent               Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children             Category[]            @relation("CategoryHierarchy")
  position             Int                   @default(0)
  isActive             Boolean               @default(true)
  imageUrl             String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  products             Product[]
  attributeDefinitions AttributeDefinition[]

  @@index([parentId])
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

/// Canonical product — "what the item is," never "who sells it, at what
/// price, with how much stock." Price/stock live on `VendorOffer`, images
/// on `ProductMedia` — Product itself carries no commercial fields.
model Product {
  id            String               @id @default(uuid()) @db.Uuid
  name          String
  slug          String               @unique
  description   String
  brandId       String?              @db.Uuid
  brand         Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId    String               @db.Uuid
  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  publishStatus ProductPublishStatus @default(PUBLISHED)

  // Derived-only — never hand-set. Recomputed transactionally by
  // ReviewsService whenever a review is created or its moderation status
  // changes (published <-> hidden), from the actual Review rows, never
  // written directly by any other code path.
  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sources         ProductSource[]
  media           ProductMedia[]
  attributeValues ProductAttributeValue[]
  variants        ProductVariant[]
  offers          VendorOffer[]
  reviews         Review[]
  wishlistedBy    Wishlist[]

  @@index([categoryId])
  @@index([brandId])
  @@index([publishStatus, createdAt])
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

/// A review always backs exactly one delivered OrderItem — orderItemId is
/// NOT NULL and unique, a structural (not just conventional) guarantee
/// that every review is a verified purchase. ReviewsService validates
/// ownership (the order belongs to the reviewer) and delivery status
/// (the backing VendorOrder is DELIVERED) before the insert can succeed.
model Review {
  id          String       @id @default(uuid()) @db.Uuid
  productId   String       @db.Uuid
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItemId String       @unique @db.Uuid
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  rating      Int
  title       String?
  body        String
  status      ReviewStatus @default(PUBLISHED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Caps total reviews per user per product at one, even across multiple
  // qualifying orders — buying the same product twice doesn't grant a
  // second review.
  @@unique([userId, productId])
  @@index([productId, status])
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

/// One default per user is enforced two ways (same "lock + defense-in-
/// depth constraint" discipline as the cart-row-lock pattern elsewhere in
/// this app): AddressService.setDefault locks the user's address rows
/// (SELECT ... FOR UPDATE) before flipping isDefault, and a hand-authored
/// partial unique index (migration SQL, see that migration's comment)
/// refuses a second true row at the database level regardless of what
/// application code does.
model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  fullName   String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

/// Ordered product images — replaces `Product.imageUrl`. Position is
/// caller-assigned (not an auto-increment) so reordering is a plain update,
/// not a resequencing of every row; uniqueness still prevents two images
/// silently claiming the same slot.
model ProductMedia {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int
  altText   String?
  createdAt DateTime @default(now())

  @@unique([productId, position])
  @@index([productId])
}

/// EAV-lite descriptive attributes ("Material: Cotton", "Battery life: 10h")
/// and the PLP filters built from them — deliberately not a heavier
/// attribute-group/template system, since nothing in scope needs one.
/// `categoryId = null` means the attribute applies platform-wide (e.g.
/// "Brand" itself could be modeled this way, though Brand already has its
/// own first-class model here); a set categoryId scopes it to that category
/// and its descendants.
model AttributeDefinition {
  id         String             @id @default(uuid()) @db.Uuid
  name       String
  slug       String             @unique
  categoryId String?            @db.Uuid
  category   Category?          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inputType  AttributeInputType @default(TEXT)
  createdAt  DateTime           @default(now())

  productValues ProductAttributeValue[]
  variantValues VariantAttributeValue[]

  @@index([categoryId])
}

model ProductAttributeValue {
  id                    String              @id @default(uuid()) @db.Uuid
  productId             String              @db.Uuid
  product               Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeDefinitionId String              @db.Uuid
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)
  value                 String

  @@unique([productId, attributeDefinitionId])
  @@index([attributeDefinitionId, value])
}

/// A purchasable variation of a canonical product (e.g. Color=Red, Size=L).
/// A product with no variants is sold directly (VendorOffer.variantId =
/// null, see that model's uniqueness note); a product with variants is only
/// ever sold *through* one of them once any variant exists — enforced at
/// the service level when an offer is created, not by the schema (the
/// schema alone can't express "either every offer for this product has a
/// variantId, or none do").
model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  attributeValues VariantAttributeValue[]
  offers          VendorOffer[]

  @@index([productId])
}

model VariantAttributeValue {
  id                    String              @id @default(uuid()) @db.Uuid
  variantId             String              @db.Uuid
  variant               ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeDefinitionId String              @db.Uuid
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)
  value                 String

  @@unique([variantId, attributeDefinitionId])
}

/// A marketplace seller. `slug` is the public storefront identity
/// (`/vendors/:slug`); `status` gates everything a vendor can do — only
/// `APPROVED` vendors can have `ACTIVE` offers surfaced to shoppers
/// (enforced in CatalogService's query, not just by hiding a button).
model Vendor {
  id                String       @id @default(uuid()) @db.Uuid
  name              String
  slug              String       @unique
  status            VendorStatus @default(PENDING)
  description       String?
  logoUrl           String?
  contactEmail      String
  /// Basis points (1/100th of a percent); 500 = 5%. Integer, same
  /// no-float discipline as every monetary/rate field in this schema.
  commissionRateBps Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  approvedAt        DateTime?
  approvedByUserId  String?      @db.Uuid

  members      VendorMember[]
  offers       VendorOffer[]
  orders       VendorOrder[]
  staffInvites VendorStaffInvite[]
  promotions   Promotion[]

  @@index([status])
}

/// Who can act for a vendor, and how. Modeled as its own join table (not a
/// second FK on User) so a vendor can have staff later without another
/// migration — the MVP only ever creates one OWNER row per vendor at
/// onboarding; the staff invite/accept lifecycle lands in Phase 3 alongside
/// the vendor app itself, this table is ready for it from day one.
model VendorMember {
  id        String           @id @default(uuid()) @db.Uuid
  vendorId  String           @db.Uuid
  vendor    Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      VendorMemberRole @default(STAFF)
  createdAt DateTime         @default(now())

  @@unique([vendorId, userId])
  @@index([userId])
}

/// A pending staff invitation — same token lifecycle as
/// EmailVerificationToken/PasswordResetToken (hashed at rest, single-use,
/// expiring), scoped to one vendor + one email address rather than a User
/// row, since the invitee may not have a ShopNest account yet. Accepting
/// creates the VendorMember row and consumes the invite in one transaction.
model VendorStaffInvite {
  id              String           @id @default(uuid()) @db.Uuid
  vendorId        String           @db.Uuid
  vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  email           String
  role            VendorMemberRole @default(STAFF)
  tokenHash       String           @unique
  invitedByUserId String           @db.Uuid
  invitedBy       User             @relation(fields: [invitedByUserId], references: [id], onDelete: Restrict)
  expiresAt       DateTime
  consumedAt      DateTime?
  // Distinct from consumedAt on purpose — an owner-revoked invite was
  // never accepted, and collapsing the two into one timestamp would make
  // "was this invite used?" ambiguous in exactly the place (an owner's
  // own member-management view) where that distinction matters most.
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())

  @@index([vendorId])
  @@index([email])
}

/// Where price and stock actually live. One row is one vendor's listing of
/// one sellable thing — either a base product (`variantId = null`) or one
/// specific variant of it, never both/ambiguous for the same row.
///
/// Uniqueness needs two indexes, not one: a normal composite unique
/// constraint treats every NULL as distinct from every other NULL, so
/// `@@unique([vendorId, productId, variantId])` alone would let the *same*
/// vendor create unlimited duplicate base-product offers (variantId always
/// NULL). The migration adds a partial unique index —
/// `UNIQUE (vendorId, productId) WHERE variantId IS NULL` — as a
/// hand-written statement (Prisma's schema DSL has no `WHERE` clause for
/// `@@unique`); the declarative `@@unique` below still correctly covers
/// every variant-specific row, since Postgres compares non-null tuples
/// normally.
model VendorOffer {
  id                  String          @id @default(uuid()) @db.Uuid
  vendorId            String          @db.Uuid
  vendor              Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  productId           String          @db.Uuid
  product             Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId           String?         @db.Uuid
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  vendorSku           String
  condition           OfferCondition  @default(NEW)
  priceCents          Int
  compareAtPriceCents Int?
  stockQuantity       Int             @default(0)
  status              OfferStatus     @default(DRAFT)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  cartItems            CartItem[]
  orderItems           OrderItem[]
  inventoryAdjustments InventoryAdjustment[]

  @@unique([vendorId, productId, variantId])
  @@unique([vendorId, vendorSku])
  @@index([productId, status])
  @@index([vendorId, status])
}

/// Every VendorOffer.stockQuantity change is written alongside one of
/// these, in the same transaction — a stock mutation with no matching
/// adjustment row (or vice versa) is a bug, not an accepted variance. This
/// is what makes stock changes auditable instead of a silent field update.
model InventoryAdjustment {
  id            String                    @id @default(uuid()) @db.Uuid
  vendorOfferId String                    @db.Uuid
  vendorOffer   VendorOffer               @relation(fields: [vendorOfferId], references: [id], onDelete: Cascade)
  /// Positive = stock added (restock, cancellation/return reversal),
  /// negative = stock removed (sale, correction downward).
  delta         Int
  reason        InventoryAdjustmentReason
  /// Free-form pointer to whatever caused this (an order id, a return
  /// request id, an import run id) — not a typed FK, since the referenced
  /// table varies by reason and this row must survive that thing's own
  /// lifecycle (e.g. an order being queried historically) unaffected.
  reference     String?
  actorUserId   String?                   @db.Uuid
  createdAt     DateTime                  @default(now())

  @@index([vendorOfferId, createdAt])
}

/// One per vendor represented in a checkout — splits a marketplace `Order`
/// into the per-seller fulfilment units that actually get shipped/status-
/// tracked independently. `Order.status` is a denormalized aggregate over
/// its VendorOrders (all DELIVERED ⇒ Order DELIVERED, any CANCELLED effect
/// documented where that transition is implemented) — see DECISIONS.md.
model VendorOrder {
  id            String      @id @default(uuid()) @db.Uuid
  orderId       String      @db.Uuid
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorId      String      @db.Uuid
  vendor        Vendor      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  status        OrderStatus @default(PENDING)
  subtotalCents Int
  /// Nonzero only when a VENDOR-scope promotion was redeemed against this
  /// vendor's share of the order — a PLATFORM-scope discount is absorbed
  /// at the Order level instead, so a vendor's own subtotal always
  /// reflects what they're actually owed.
  discountCents Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  promotionRedemptions PromotionRedemption[]

  @@unique([orderId, vendorId])
  @@index([vendorId, status])
}

model ProductSource {
  id         String        @id @default(uuid()) @db.Uuid
  productId  String        @db.Uuid
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  source     CatalogSource
  externalId String
  checksum   String
  lastSeenAt DateTime
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([source, externalId])
  @@unique([productId, source])
  @@index([productId])
}

model CatalogImportRun {
  id              String              @id @default(uuid()) @db.Uuid
  source          CatalogSource
  status          CatalogImportStatus @default(RUNNING)
  discoveredCount Int                 @default(0)
  createdCount    Int                 @default(0)
  updatedCount    Int                 @default(0)
  unchangedCount  Int                 @default(0)
  errorMessage    String?
  attemptCount    Int                 @default(0)
  maxAttempts     Int                 @default(3)
  availableAt     DateTime            @default(now())
  lockedAt        DateTime?
  lockedBy        String?
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  categoryScope   String[]            @default([])
  maxRecords      Int?
  minImageCount   Int?

  // Batch checkpoint — how many of the (deterministically ordered) scoped
  // products have already been committed. A retry or a lease-expiry
  // reclaim by a different worker resumes from here instead of
  // reprocessing the whole run; each batch's own short transaction
  // advances this alongside its counts, so the two never drift apart.
  scopedCount    Int @default(0)
  processedCount Int @default(0)
  // Permanently-invalid supplier records skipped during this run — never
  // retried (they're not a transient failure), but explicitly counted
  // rather than silently dropped.
  skippedCount   Int @default(0)

  @@index([source, startedAt])
  @@index([status, startedAt])
  @@index([status, availableAt])
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  /// Pre-checkout only — re-validated live, under lock, at checkout time.
  /// The redemption itself (and the discount that actually applied) is
  /// recorded on PromotionRedemption, not here.
  appliedPromotionId String?    @db.Uuid
  appliedPromotion   Promotion? @relation(fields: [appliedPromotionId], references: [id], onDelete: SetNull)

  items CartItem[]
}

/// A cart line always references one concrete purchasable VendorOffer —
/// never the canonical product directly, since price/stock authority (what
/// checkout actually locks against) lives there.
model CartItem {
  id            String      @id @default(uuid()) @db.Uuid
  cartId        String      @db.Uuid
  cart          Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  vendorOfferId String      @db.Uuid
  vendorOffer   VendorOffer @relation(fields: [vendorOfferId], references: [id], onDelete: Restrict)
  quantity      Int
  addedAt       DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([cartId, vendorOfferId])
  @@index([cartId])
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Denormalized aggregate over this order's VendorOrders, not an
  /// independently-set value once vendorOrders exist — see VendorOrder's
  /// model doc and the aggregation invariant in DECISIONS.md.
  status         OrderStatus @default(PENDING)
  totalCents     Int
  currency       String      @default("USD")
  idempotencyKey String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  /// Snapshot of whatever discount applied at checkout — the authoritative
  /// redemption record is PromotionRedemption; this is here so an order's
  /// own total is self-explanatory without a join.
  discountCents Int     @default(0)
  /// The payment provider's charge reference for this order — set by
  /// PaymentProvider.charge() inside the same checkout transaction that
  /// creates this row. Reused as the reference on any later refund.
  paymentRef    String?

  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  vendorOrders        VendorOrder[]
  promotionRedemption PromotionRedemption?

  @@unique([userId, idempotencyKey], name: "Order_userId_idempotencyKey_key")
  @@index([userId, createdAt])
  @@index([status])
}

/// productName/productSlug/vendorName are point-in-time snapshots, not live
/// joins — a product being renamed or a vendor being renamed/suspended
/// later must never rewrite how a historical order displays. `product` is
/// still reachable live via `vendorOffer.product` when needed (e.g. to
/// link to the current PDP), but nothing here depends on that relation for
/// its own correctness.
model OrderItem {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @db.Uuid
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorOfferId  String         @db.Uuid
  vendorOffer    VendorOffer    @relation(fields: [vendorOfferId], references: [id], onDelete: Restrict)
  vendorOrderId  String         @db.Uuid
  vendorOrder    VendorOrder    @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  quantity       Int
  unitPriceCents Int
  productName    String
  productSlug    String
  vendorName     String
  review         Review?
  returnRequest  ReturnRequest?

  @@index([orderId])
  @@index([vendorOrderId])
}

/// @deprecated orderId as the primary reference — a status transition now
/// happens on a specific VendorOrder (each seller fulfils independently);
/// vendorOrderId is the row that actually changed, orderId stays populated
/// too so "this order's full timeline" stays a single indexed query instead
/// of a join through every child VendorOrder.
model OrderStatusHistory {
  id            String      @id @default(uuid()) @db.Uuid
  orderId       String      @db.Uuid
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorOrderId String      @db.Uuid
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  changedById   String      @db.Uuid
  changedBy     User        @relation("changedBy", fields: [changedById], references: [id], onDelete: Restrict)
  fromStatus    OrderStatus
  toStatus      OrderStatus
  createdAt     DateTime    @default(now())

  @@index([orderId])
  @@index([vendorOrderId])
}

enum ReturnReason {
  DEFECTIVE
  NOT_AS_DESCRIBED
  NO_LONGER_NEEDED
  WRONG_ITEM
  OTHER
}

enum ReturnStatus {
  REQUESTED
  REJECTED
  REFUNDED
}

/// One request per order item, ever — @unique on orderItemId, and a
/// rejected request is terminal (no re-file endpoint exists). Approval and
/// refund happen together: this scope has no separate "approved, refund
/// pending" state, since the mock payment adapter's refund is synchronous.
model ReturnRequest {
  id              String       @id @default(uuid()) @db.Uuid
  orderItemId     String       @unique @db.Uuid
  orderItem       OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  userId          String       @db.Uuid
  user            User         @relation("returnRequester", fields: [userId], references: [id], onDelete: Restrict)
  reason          ReturnReason
  note            String?
  status          ReturnStatus @default(REQUESTED)
  decidedByUserId String?      @db.Uuid
  decidedBy       User?        @relation("returnDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  /// The decider's own note — distinct from `note` above (the customer's,
  /// set at request time). Mainly useful on rejection.
  decisionNote    String?
  decidedAt       DateTime?
  createdAt       DateTime     @default(now())

  @@index([status, createdAt])
}

enum PromotionType {
  PERCENT
  FIXED_AMOUNT
}

enum PromotionScope {
  PLATFORM
  VENDOR
}

/// value is a percent (1-100) when type=PERCENT, or integer cents when
/// type=FIXED_AMOUNT — range-checked by type via a hand-written CHECK
/// (see the migration), the same technique already used elsewhere in this
/// schema for constraints Prisma's DSL can't express.
model Promotion {
  id                    String         @id @default(uuid()) @db.Uuid
  code                  String         @unique
  type                  PromotionType
  value                 Int
  scope                 PromotionScope
  vendorId              String?        @db.Uuid
  vendor                Vendor?        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  startsAt              DateTime
  endsAt                DateTime
  maxRedemptions        Int?
  maxRedemptionsPerUser Int?
  minSubtotalCents      Int?
  isActive              Boolean        @default(true)
  createdByUserId       String         @db.Uuid
  createdBy             User           @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  carts       Cart[]
  redemptions PromotionRedemption[]

  @@index([scope, vendorId])
  @@index([isActive])
}

/// One row per order a code was actually redeemed on — orderId is
/// @unique because this scope allows exactly one code per order (no
/// stacking); this table (not a live COUNT over Order) is what
/// maxRedemptions/maxRedemptionsPerUser are checked against, under the
/// promotion row lock, at checkout.
model PromotionRedemption {
  id            String       @id @default(uuid()) @db.Uuid
  promotionId   String       @db.Uuid
  promotion     Promotion    @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  orderId       String       @unique @db.Uuid
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  userId        String       @db.Uuid
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  vendorOrderId String?      @db.Uuid
  vendorOrder   VendorOrder? @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  amountCents   Int
  createdAt     DateTime     @default(now())

  @@index([promotionId, userId])
}
