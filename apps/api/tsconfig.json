{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true
  },
  // prisma/seed.ts is run directly by Node's own type-stripping
  // (`db:seed`), which requires an explicit .ts import extension —
  // incompatible with this project's tsc, which rejects one. Never part
  // of the compiled app, so excluding it here costs nothing.
  "exclude": ["node_modules", "dist", "prisma/seed.ts"]
}
