# Database
DATABASE_URL="postgresql://shopnest:shopnest@localhost:5432/shopnest_dev"

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (used for CORS and Origin validation)
WEB_URL=http://localhost:3000

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-64-bytes-hex
JWT_REFRESH_SECRET=change-me-refresh-secret-64-bytes-hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Grace period for concurrent refresh (milliseconds)
REFRESH_GRACE_PERIOD_MS=30000

# Cart limit per product
CART_MAX_QTY_PER_PRODUCT=10

# Supplier catalog import
CATALOG_IMPORT_URL=https://dummyjson.com
CATALOG_IMPORT_TIMEOUT_MS=5000

# Background catalog-sync worker/scheduler (see docs/catalog-background-sync.md)
CATALOG_WORKER_ENABLED=true
CATALOG_WORKER_POLL_MS=2000
CATALOG_WORKER_LEASE_SECONDS=300
CATALOG_SCHEDULE_ENABLED=true
CATALOG_SCHEDULE_INTERVAL_MS=21600000

# Reverse geocoding provider (replaceable server-side integration)
GEOCODING_URL=https://nominatim.openstreetmap.org
GEOCODING_TIMEOUT_MS=5000

# Optional: enables Google Places autocomplete for Punjab, Pakistan.
# When omitted, the API uses the OpenStreetMap provider for local development.
GOOGLE_PLACES_API_KEY=

# Rate limiting (per-IP, applies to every route via the global ThrottlerGuard).
# register/login/refresh/resend-verification/forgot-password/reset-password
# additionally carry their own stricter static per-route limits — see auth.controller.ts.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Mail — provider-selected-by-env, same pattern as geocoding.
# `local` (default) logs the email instead of sending it — every flow that
# depends on "receiving an email" (verification, password reset, later
# vendor staff invites) is fully functional and testable without real SMTP.
# Set MAIL_PROVIDER=smtp + the SMTP_* vars below for real delivery.
MAIL_PROVIDER=local
MAIL_FROM_ADDRESS=no-reply@shopnest.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Token lifetimes (milliseconds)
EMAIL_VERIFICATION_TOKEN_TTL_MS=86400000
PASSWORD_RESET_TOKEN_TTL_MS=3600000
