# Database
DATABASE_URL="postgresql://shopnest:shopnest@localhost:5432/shopnest_dev"

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (used for CORS and Origin validation)
WEB_URL=http://localhost:3000

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-64-bytes-hex
JWT_REFRESH_SECRET=change-me-refresh-secret-64-bytes-hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Grace period for concurrent refresh (milliseconds)
REFRESH_GRACE_PERIOD_MS=30000

# Cart limit per product
CART_MAX_QTY_PER_PRODUCT=10

# Supplier catalog import — DummyJSON (general merchandise, has pricing)
CATALOG_IMPORT_URL=https://dummyjson.com
CATALOG_IMPORT_TIMEOUT_MS=5000
# Products per checkpointed transaction — keeps a run resumable and each
# batch's lock/rollback cost bounded regardless of total catalog size.
CATALOG_IMPORT_BATCH_SIZE=25

# Supplier catalog import — Open Food Facts (groceries, open/keyless, no
# pricing data — imports land as DRAFT/offer-less for an admin to price).
OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_TIMEOUT_MS=8000
OPEN_FOOD_FACTS_PAGE_SIZE=100

# Supplier catalog import — Amazon Reviews 2023 catalog metadata
# (McAuley Lab, Hugging Face — open, keyless). Several real images per
# product; rarely a usable price, so most imports land as DRAFT/
# offer-less too. No search API — reads fixed per-category files and
# stops early once AMAZON_CATALOG_PER_CATEGORY_LIMIT records are found.
AMAZON_CATALOG_URL=https://huggingface.co/datasets/McAuley-Lab/Amazon-Reviews-2023/resolve/main/raw/meta_categories
AMAZON_CATALOG_TIMEOUT_MS=20000
AMAZON_CATALOG_PER_CATEGORY_LIMIT=150

# Background catalog-sync worker/scheduler (see docs/catalog-background-sync.md).
# The catalog is admin-curated (manual product entry via the admin UI)
# rather than supplier-driven, so the SCHEDULER stays off by default —
# nothing is ever queued on its own. The WORKER stays on: it's what
# actually processes a run once an admin clicks "Run synchronization" in
# /admin/imports (that click also fires one immediate poll so it starts
# right away, but the worker process needs to be running for retries/
# resumes to happen afterward — turning it off would leave a failed run
# stuck until someone manually triggers it again).
CATALOG_WORKER_ENABLED=true
CATALOG_WORKER_POLL_MS=2000
CATALOG_WORKER_LEASE_SECONDS=300
CATALOG_SCHEDULE_ENABLED=false
CATALOG_SCHEDULE_INTERVAL_MS=21600000

# Reverse geocoding provider (replaceable server-side integration)
GEOCODING_URL=https://nominatim.openstreetmap.org
GEOCODING_TIMEOUT_MS=5000

# Optional: enables Google Places autocomplete for Punjab, Pakistan.
# When omitted, the API uses the OpenStreetMap provider for local development.
GOOGLE_PLACES_API_KEY=

# Rate limiting (per-IP, applies to every route via the global ThrottlerGuard).
# register/login/refresh/resend-verification/forgot-password/reset-password
# additionally carry their own stricter static per-route limits — see auth.controller.ts.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Mail — provider-selected-by-env, same pattern as geocoding.
# `local` (default) logs the email instead of sending it — every flow that
# depends on "receiving an email" (verification, password reset, later
# vendor staff invites) is fully functional and testable without real SMTP.
# Set MAIL_PROVIDER=smtp + the SMTP_* vars below for real delivery.
MAIL_PROVIDER=local
MAIL_FROM_ADDRESS=no-reply@shopnest.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Token lifetimes (milliseconds)
EMAIL_VERIFICATION_TOKEN_TTL_MS=86400000
PASSWORD_RESET_TOKEN_TTL_MS=3600000

# Payment — provider-selected-by-env, same pattern as mail/geocoding. No real
# gateway credentials in this scope; MockPaymentAdapter is the only adapter.
# An order priced at exactly this amount is deterministically declined, so
# the decline path is testable without relying on randomness.
PAYMENT_MOCK_DECLINE_CENTS=66600

# Media storage — same provider-selected-by-env shape as mail/payment. No
# bucket credentials in this scope; LocalMediaStorageAdapter is the only
# adapter, writing under MEDIA_UPLOAD_DIR (relative to the process's cwd)
# and served back out at /uploads. MEDIA_PUBLIC_BASE_URL must be this API's
# own externally-reachable origin — the frontend is a different origin, so
# a relative path in a returned URL would resolve against the wrong one.
MEDIA_PROVIDER=local
MEDIA_UPLOAD_DIR=uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:3001
MEDIA_MAX_FILE_SIZE_BYTES=5242880
