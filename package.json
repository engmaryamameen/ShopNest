{
  "name": "shopnest",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "3.5.3",
    "turbo": "2.5.4",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "express>proxy-addr": "2.0.8",
      "sharp": ">=0.35.5",
      "@nestjs/platform-express>multer": "2.5.0",
      "next>postcss": "8.5.18",
      "postcss>nanoid": "3.3.18",
      "express>body-parser": "2.4.0",
      "js-yaml@^4": "4.3.2",
      "js-yaml@^5": "5.2.2",
      "brace-expansion@^1": "1.1.20",
      "brace-expansion@^2": "2.1.6",
      "brace-expansion@^5": "5.0.11",
      "fast-uri": "3.1.7",
      "tar@^7": "7.5.21",
      "browserslist": "4.28.7",
      "source-map-js": "1.2.2"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "nestjs-pino",
      "prisma",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
